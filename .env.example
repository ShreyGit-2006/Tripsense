# TripSense — optional environment variables
# Copy this file to .env and fill in any keys you want to use.
# The application works fully without any of these keys.

# Optional: LLM provider for the RAG travel assistant
# Supported values: "openai" | "google"  (leave blank for local fallback)
TRIPSENSE_LLM_PROVIDER=

# OpenAI (only needed if TRIPSENSE_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Generative AI (only needed if TRIPSENSE_LLM_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash
